# ---
# delimiter: ','
# datatype:
# - {name: srcname   , unit:    , datatype: string     , description: Source name                                          }
# - {name: t         , unit: mjd     , datatype: float64 , description: Time of measurement                                  }
# - {name: t_wlo     , unit: d    , datatype: float32 , description: Lower width of time bin                                 }
# - {name: t_wup     , unit: d    , datatype: float32 , description: Upper width of time bin                                 }
# - {name: texpo     , unit: h    , datatype: float32 , description: Exposure time                                           }
# - {name: flux     , unit: mJy, datatype: float32 , description: Flux measured above the energy threshold              }
# - {name: flux_elo , unit: mJy, datatype: float32 , description: Lower uncertainty of flux                             }
# - {name: flux_eup , unit: mJy, datatype: float32 , description: Upper uncertainty of flux                             }
# - {name: eth_lo      , unit: nm,      datatype: float32 , description: Assumed lower energy threshold for integral flux calculation}
# - {name: eth_up      , unit: nm,      datatype: float32 , description: Assumed upper energy threshold for integral flux calculation}
# - {name: instrument, unit:    , datatype: string     , description: Instrument                                           }
# - {name: dataformat, unit:    , datatype: string     , description: Data Format                                          }
# - {name: comments  , unit:    , datatype: string     , description: Comments                                             }
# meta: !!omap
# - {Filename: 2023f_fig2e_lc_optical.ecsv}
# - {Source: "Mrk 501"}
# - {Figure: "Figure 2, panel e (fifth from top) in the paper."}
# - {Title: "Multimessenger Characterization of Markarian 501 during Historically Low X-Ray and -Ray Activity"}
# - {Comments: "Datapoints of the optical R band light curve from the Tuorla Observatory and from the GLAST and AGILE program (GASP) of the Whole Earth Blazar Telescope (WEBT), obtained using a variety of facilities (see Section 2.5 in the paper), in the MJD 57,754 to MJD 59,214 time range."}
# - {Reference: "magic_2023f.yaml"}
# - {Status: "To be checked"}

